---
import Base from '../../layouts/Base.astro';
import { getGuides, lex, renderTokens } from '../../lib/content';

export function getStaticPaths() {
  return getGuides().map((guide) => ({ params: { id: guide.id } }));
}

// 表示のたびに読み直す（理由は recipes/[category]/[id].astro と同じ）
const guide = getGuides().find((g) => g.id === Astro.params.id);
if (!guide) return Astro.redirect('/404/');
const tokens = lex(guide.body).filter((t) => t.type !== 'space');
// 最初の段落はリード文として表示する
const lead = tokens[0]?.type === 'paragraph' ? tokens.shift()! : undefined;
const eyebrow = guide.data.nav_group === 'help' ? 'Help' : 'Guide';
---
<Base title={guide.data.title} description={lead ? (lead as any).text : undefined}>
  <p class="eyebrow">{eyebrow}</p>
  <h1>{guide.data.title}</h1>
  {lead && <Fragment set:html={renderTokens([lead]).replace(/^<p>/, '<p class="lead">')} />}
  <div class="prose"><Fragment set:html={renderTokens(tokens)} /></div>
</Base>
